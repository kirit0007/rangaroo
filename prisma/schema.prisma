datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  role      Role     @default(CUSTOMER)
  orders    Order[]
  reviews   Review[]
  createdAt DateTime @default(now())
}

enum Role {
  CUSTOMER
  ADMIN
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  description      String
  shortDescription String
  price            Float
  compareAtPrice   Float?
  figureCount      Int
  paintType        String
  categoryId       String
  collectionId     String
  isFeatured       Boolean     @default(false)
  isNewLaunch      Boolean     @default(false)
  images           String[]
  kitContents      String[]
  stock            Int         @default(100)
  orderItems       OrderItem[]
  reviews          Review[]
  createdAt        DateTime    @default(now())
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String?
  user              User?         @relation(fields: [userId], references: [id])
  customerName      String
  customerEmail     String
  customerPhone     String
  address           String
  city              String
  state             String
  pinCode           String
  subtotal          Float
  shippingFee       Float
  totalAmount       Float
  paymentStatus     PaymentStatus @default(PENDING)
  orderStatus       OrderStatus   @default(PROCESSING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  items             OrderItem[]
  createdAt         DateTime      @default(now())
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userName  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Float
  minSpend        Float    @default(0)
  isActive        Boolean  @default(true)
}
